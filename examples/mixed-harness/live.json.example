{
  "enable_egress": true,
  "enable_console": true,
  "harness": "fake",
  "seat_harnesses": {
    "eng_lead": {
      "adapter": "claude-code",
      "model": {
        "connection": "anthropic",
        "id": "claude-sonnet-5-5"
      }
    },
    "engineer": {
      "adapter": "codex",
      "model": {
        "connection": "openai",
        "id": "gpt-5.5"
      }
    },
    "reviewer": {
      "adapter": "pi",
      "model": {
        "connection": "i14",
        "id": "qwen3.8-27b"
      }
    }
  },
  "model_connections": {
    "anthropic": {
      "adapter": "anthropic",
      "secret_ref": "k8s:anthropic-credentials"
    },
    "openai": {
      "adapter": "openai",
      "secret_ref": "k8s:openai-credentials"
    },
    "i14": {
      "adapter": "model",
      "secret_ref": "k8s:i14-credentials",
      "endpoint_ref": "https://api-dev.i14.ai/v1",
      "model": {
        "apis": [
          "openai_chat"
        ],
        "models": [
          {
            "id": "qwen3.8-27b"
          }
        ]
      }
    }
  },
  "extra_connections": {
    "github": {
      "adapter": "github",
      "secret_ref": "k8s:github-credentials"
    }
  },
  "access_profiles": {
    "github_engineer": {
      "tools": {
        "binaries": [
          "git",
          "gh"
        ]
      },
      "github": {
        "connection": "github",
        "repos": [
          "OWNER/TEST-REPO"
        ],
        "permissions": {
          "contents": "write",
          "pull_requests": "write"
        },
        "delivery": "sandbox"
      }
    }
  },
  "seat_access": {
    "engineer": [
      "github_engineer"
    ]
  },
  "enable_linear": false
}
