# Copy to terraform.tfvars and fill in. Keep terraform.tfvars out of version
# control: it holds credentials.

kube_context = "my-cluster" # kubectl config get-contexts

# Either give the credentials here (they are stored in this stage's state)...
slack_bot_token   = "xoxb-..."
slack_app_token   = "xapp-..."
anthropic_api_key = "sk-ant-..."
# linear_api_key  = "lin_api_..."

# ...or create the Secrets yourself and only reference them, which keeps the
# values out of Terraform. Rotating a value in place needs no Terraform run.
#   kubectl -n steadmesh-system create secret generic slack-credentials \
#     --from-literal=bot_token=xoxb-... --from-literal=app_token=xapp-...
# existing_secret_refs = {
#   slack     = "k8s:slack-credentials"
#   anthropic = "vault:steadmesh/anthropic"
# }

# enable_console = true
